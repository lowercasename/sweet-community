# Copy this file to .env in the same directory.

# The address people will open. Point its DNS at this server before starting.
SWEET_DOMAIN=sweet.example.org

# Outgoing email, for sign-in and password reset links. Leave these empty and
# each message is written to a file in the data volume instead.
SWEET_SMTP_HOST=
SWEET_SMTP_PORT=587
SWEET_SMTP_USER=
SWEET_SMTP_PASSWORD=
SWEET_MAIL_FROM=sweet@example.org

# An S3 bucket (Cloudflare R2 or any other) for images and database backups.
# Leave these empty and images stay on this server, with no backups.
SWEET_S3_ENDPOINT=
SWEET_S3_BUCKET=
SWEET_S3_ACCESS_KEY=
SWEET_S3_SECRET_KEY=
#SWEET_S3_REGION=auto

# compose.proxied.yml only: where Sweet listens for your reverse proxy.
#SWEET_PORT=8080
#SWEET_BIND=127.0.0.1
# The number of reverse proxies in front of Sweet that add the visitor's address to X-Forwarded-For. Sweet reads the
# visitor's address that many entries from the right, for its rate limits. The bundled Caddy counts as one.
#SWEET_TRUST_PROXY=1

# A particular image instead of the latest one, for going back after a bad upgrade. See the README.
#SWEET_IMAGE=ghcr.io/lowercasename/sweet-community:sha-0000000
