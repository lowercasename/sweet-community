# Copy to .env beside compose.yml. Lines starting with # are off.

# The address people will open. DNS for it must point at this host before
# you start (Caddy gets the certificate on the first request).
SWEET_DOMAIN=sweet.example.org

# Email: the links that verify an address and reset a password. Any SMTP
# service. Without these, each message is written to a file in the data
# volume instead (docker compose exec sweet ls /data/mail).
SWEET_SMTP_HOST=
SWEET_SMTP_PORT=587
SWEET_SMTP_USER=
SWEET_SMTP_PASSWORD=
SWEET_MAIL_FROM=sweet@example.org

# The bucket: images, and a live backup of the database. Cloudflare R2:
# make a bucket, then an API token with Object Read & Write on it; the
# endpoint is <account id>.r2.cloudflarestorage.com. Any S3 service works
# (set SWEET_S3_REGION to its region; R2 takes auto). Without these, images
# stay on this host's disk and nothing is backed up.
SWEET_S3_ENDPOINT=
SWEET_S3_BUCKET=
SWEET_S3_ACCESS_KEY=
SWEET_S3_SECRET_KEY=
#SWEET_S3_REGION=auto

# compose.proxied.yml only: the port your proxy sends to, and the address
# it listens on. 127.0.0.1 is right for a proxy running on this host. A
# proxy that is itself a container cannot reach 127.0.0.1: give it the
# docker bridge address instead (`ip -4 addr show docker0`, usually
# 172.17.0.1), which containers reach as host.docker.internal when started
# with `--add-host host.docker.internal:host-gateway`, and which the
# internet cannot.
#SWEET_PORT=8080
#SWEET_BIND=127.0.0.1
