# Copy to .env (gitignored). `make dev-backend` and `make run` load it.

# Email: verification links and password resets. Leave unset to write each
# message to a file in data/mail (-mail-dir) instead of sending it.
#SWEET_SMTP_HOST=smtp.mailgun.org
#SWEET_SMTP_PORT=587
#SWEET_SMTP_USER=
#SWEET_SMTP_PASSWORD=
#SWEET_MAIL_FROM=sweet@example.org
# Where links in email point; the address people open the instance at.
#SWEET_BASE_URL=https://sweet.example.org

# Images. Leave all of these unset to keep files in data/images.
# Cloudflare R2: endpoint is <account id>.r2.cloudflarestorage.com, region auto,
# keys from an R2 API token with object read and write on this bucket.
#SWEET_S3_ENDPOINT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
#SWEET_S3_BUCKET=sweet-images
#SWEET_S3_ACCESS_KEY=
#SWEET_S3_SECRET_KEY=
#SWEET_S3_REGION=auto
# A folder for this instance inside the bucket. Images then go under <folder>/images instead of images/.
#SWEET_S3_FOLDER=
# Only for a plain-http S3 stand-in such as MinIO on localhost.
#SWEET_S3_INSECURE=0
